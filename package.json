{
  "name": "kraldor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "assets": "node scripts/portrait-assets.mjs",
    "prebuild": "node scripts/portrait-assets.mjs",
    "build": "prisma migrate deploy && next build --turbopack",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:wipe": "tsx scripts/wipe-data.ts",
    "db:admin": "tsx scripts/grant-admin.ts",
    "db:test-user": "tsx --tsconfig scripts/tsconfig.json scripts/create-test-user.ts",
    "mail:test": "tsx scripts/test-mail.ts",
    "vercel:env": "bash scripts/vercel-env-sync.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:power": "tsx scripts/backfill-power.ts",
    "db:guild-leaders": "tsx scripts/repair-guild-leadership.ts",
    "db:clamp": "tsx scripts/repair-out-of-range.ts",
    "db:bots": "tsx scripts/normalize-bots.ts",
    "i18n": "node scripts/i18n-coverage.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^16.2.12",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "//overrides": "Forced past two high-severity advisories that Next bundles and cannot be reached by upgrading it (16.2.12 still ships postcss 8.4.31 and sharp 0.34.x; `npm audit fix --force` proposes next@9, a four-year downgrade). postcss: GHSA-qx2v-qp2m-jg93 / 6g55-p6wh-862q / r28c-9q8g-f849. sharp: GHSA-f88m-g3jw-g9cj (libvips CVE-2026-33327/33328/35590/35591). Both are same-major bumps and the full build plus both test suites pass on them. Drop these once Next's own ranges have moved past the fixed versions.",
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
