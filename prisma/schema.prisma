generator client {
  provider        = "prisma-client-js"
  // relationJoins lets hot reads (FULL_EMPIRE_INCLUDE, run on every /game page
  // load) fetch all relations in one JOINed query via relationLoadStrategy:
  // "join", instead of Prisma's default one-query-per-relation (~10 round-trips).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"

  // These deliberately do NOT use the names `DATABASE_URL` / `DIRECT_URL`.
  //
  // The database is provisioned through the Vercel↔Neon marketplace
  // integration, which owns and re-syncs its own `DATABASE_URL`,
  // `DATABASE_URL_UNPOOLED`, `POSTGRES_*`, `PG*` and `NEON_PROJECT_ID` vars in
  // the Vercel project. A hand-edited `DATABASE_URL` therefore collides with
  // the integration's copy, and any manual edit to it — notably the
  // `pgbouncer=true` below — is liable to be silently overwritten on the next
  // sync. Reading names the integration does not manage makes the app's
  // connection config ours alone.
  //
  // Pooled connection (Neon's -pooler host in prod), used by the running app.
  // MUST carry `?pgbouncer=true`: the pooler is PgBouncer in transaction mode,
  // where Prisma's prepared statements collide across sessions and surface as
  // `prepared statement "s0" already exists` under concurrency only.
  url = env("PRISMA_DATABASE_URL")

  // Unpooled connection used by `prisma migrate` — migrations take advisory
  // locks, which a transaction-mode pooler cannot hold. No `pgbouncer=true`
  // here. Locally this is just the same URL as PRISMA_DATABASE_URL.
  directUrl = env("PRISMA_DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  /// Null for accounts that only sign in with Google (no password set). A
  /// password account and a Google identity can coexist on one row once linked
  /// by verified email — see src/server/actions/auth.ts (googleSignIn).
  passwordHash  String?
  /// Google account subject (`sub` claim), set when the user links/signs up with
  /// Google. Unique so one Google account maps to at most one user.
  googleId      String?   @unique
  /// Optional avatar URL supplied by Google at sign-in.
  image         String?
  name          String
  role          Role      @default(USER)
  /// When the ban was handed down. Never a ban check on its own — see
  /// `bannedUntil` and `isBanned()` in src/lib/ban.ts.
  /// Whether this player wants to hear about what happened while they were
  /// away — a raid they lost, a sabotage cell in their warehouses. Opt-*out*,
  /// because the whole point is reaching somebody who is not looking at the
  /// game, and a notification nobody switched on is a notification nobody gets.
  ///
  /// It is the only kind of mail the game sends unprompted, and it is rationed
  /// hard (see NOTIFY_COOLDOWN_MS): a player being farmed must not receive
  /// twenty emails, and the free mail tier is 300 a day for the entire game.
  notifyRaids   Boolean   @default(true)
  /// When the last such notification actually went out. The cooldown IS this
  /// column: the send is a guarded UPDATE with a `lt` on it, so two concurrent
  /// raids cannot both slip through the window.
  notifiedAt    DateTime?
  bannedAt      DateTime?
  /// When a ban lifts by itself; null while `bannedAt` is set means permanent.
  /// A ban is live only while `bannedAt != null && (bannedUntil == null ||
  /// bannedUntil > now)` — nothing sweeps expired rows, so every read evaluates
  /// the deadline instead of trusting `bannedAt`.
  bannedUntil   DateTime?
  /// Bumped to invalidate every previously-issued session JWT (stateless, so a
  /// token stays valid until expiry otherwise). Embedded as the `ver` claim at
  /// sign time and re-checked on every request; a password reset increments it,
  /// logging out all existing sessions. See src/lib/auth.ts.
  tokenVersion  Int       @default(0)
  /// Consecutive failed password attempts since the last success. Reset to 0 on
  /// a successful login. Backs the account lockout in src/server/actions/auth.ts
  /// — the in-process rate limiter cannot throttle brute force on a serverless
  /// fleet, because each instance keeps its own counters and loses them on cold
  /// start, so the durable counter lives here instead.
  failedLogins  Int       @default(0)
  /// Set while the account is locked out; login is refused until it passes.
  lockedUntil   DateTime?
  /// When the user proved control of this address. Null = unverified, which
  /// blocks all gameplay (see requireEmpire / getActiveEmpireId). Google
  /// sign-ins are verified on arrival via the provider's email_verified claim.
  emailVerified DateTime?
  /// The client IP this account registered from, and the one it most recently
  /// signed in from. Stored to surface *alt clusters* — several accounts that
  /// share an address are one person's farm more often than a coincidence — in
  /// the admin monitor (getSharedIpClusters). Deliberately a *signal for a human
  /// to review*, never an automatic block: a shared address is also a household,
  /// a dorm, a workplace or a phone carrier's NAT, so the false-positive rate is
  /// far too high to act on without eyes.
  ///
  /// Raw, not hashed, on purpose: hashing preserves "do these two match" but
  /// destroys the judgement the review depends on — a residential ISP address
  /// reads very differently from a datacenter/VPN one, and only the raw value
  /// tells them apart. The table is admin-only. `null` when the IP could not be
  /// read (dev, or a direct connection); nulls never cluster — see clientIp.
  signupIp      String?
  lastLoginIp   String?
  /// This player's invite code — the tail of the link they hand out (see
  /// `referralLink` in src/lib/game/referral.ts). Minted on the account's first
  /// registration or first visit to the referrals screen, never rotated.
  ///
  /// It lives on the **User**, not the Empire, for one reason: a season restart
  /// deletes and re-creates every empire, and a link posted in a Discord channel
  /// has to keep working across that. Twelve characters of CSPRNG out of a
  /// 32-symbol alphabet is 60 bits — the code is not guessable, so `/r/<code>`
  /// is not an enumeration oracle for who plays here.
  referralCode  String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  empire             Empire?
  verificationTokens EmailVerificationToken[]
  devices            DeviceAccount[]

  /// The alt-cluster lookups: group accounts by the address they share.
  @@index([signupIp])
  @@index([lastLoginIp])
}

/// One (browser, account) pair the game has seen — the backbone of the
/// self-invite check on הזמנת חבר.
///
/// A long-lived first-party cookie (`kraldor_device`, see src/lib/device.ts)
/// carries an opaque random id, and every sign-in and registration records the
/// account it was used for. Two accounts that share a row here have been signed
/// into from the same browser profile, which is a far sharper signal than a
/// shared IP: an address is a household, a dorm or a carrier's NAT, but a
/// browser profile is one person. That is why a device match is allowed to
/// *refuse* a referral outright where a shared address only holds it for review
/// (see src/server/referralGuard.ts).
///
/// What it deliberately is not is a fingerprint. Nothing is derived from the
/// machine — no canvas, no fonts, no user-agent hashing — so clearing cookies
/// clears it, which is the honest trade: a farmer who works in incognito is not
/// caught by this, and no innocent player is caught by it either.
model DeviceAccount {
  id       String @id @default(cuid())
  /// The cookie's opaque value. Not a user id and not derived from one, so a
  /// row here says "this browser signed into that account" and nothing else.
  deviceId String
  userId   String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per pair — the sighting is an upsert on this key, so a player who
  /// signs in daily leaves one row, not one per session.
  @@unique([deviceId, userId])
  /// "Which accounts has this browser been?" — the self-invite check.
  @@index([deviceId])
  @@index([userId])
}

/// One outstanding "confirm your email" link.
model EmailVerificationToken {
  id String @id @default(cuid())

  userId     String
  /// SHA-256 of the token that was emailed — the raw value is never stored, so
  /// read access to this table cannot be replayed into an account takeover.
  /// Unique so a lookup by hash is a single indexed read.
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Set the moment the link is used; a consumed token is never accepted again.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-row (`id = "singleton"`) table holding admin-editable global game
/// balance. `data` is a JSON overlay merged over DEFAULT_TUNABLES in code —
/// see src/lib/game/config.ts.
model GameConfig {
  id        String   @id @default("singleton")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

enum MiniGameType {
  FIND_BALL
  CRACK_SAFE
  /// מפת האוצר — a grid with one buried cell; every dig comes back with how
  /// close it was. See src/lib/game/minigame.ts.
  TREASURE_MAP
  /// חידה — an admin-authored question with a text answer.
  RIDDLE
}

/// An admin-authored mini-game event (find-the-ball / crack-the-safe). When
/// `isActive`, it shows as a big panel at the top of every player's screen and
/// grants the prize bundle to winners. `config` holds the secret answer +
/// public params ({cups,answer} or {digits,code}) — never send answer/code to
/// the client.
model MiniGameEvent {
  id           String       @id @default(cuid())
  type         MiniGameType
  title        String
  config       Json
  maxAttempts  Int          @default(5)
  /// 0 = unlimited winners.
  maxWinners   Int          @default(0)
  winnersCount Int          @default(0)
  isActive     Boolean      @default(false)

  /// How long a release lasts, in minutes (0 = until the admin stops it). Kept
  /// on the event so re-activating it reuses the last chosen duration.
  durationMinutes Int @default(0)

  prizeGold       Float @default(0)
  prizeWood       Float @default(0)
  prizeIron       Float @default(0)
  prizeStone      Float @default(0)
  prizeDiamonds   Float @default(0)
  prizeCitizens   Int   @default(0)
  prizeTurns      Int   @default(0)
  prizeWheelSpins Int   @default(0)

  createdAt   DateTime  @default(now())
  activatedAt DateTime?
  /// When a timed release auto-expires (null = no deadline). Read as the real
  /// gate alongside `isActive`; the flag is flipped lazily on first read after.
  endsAt      DateTime?
  endedAt     DateTime?
  updatedAt   DateTime  @updatedAt

  entries MiniGameEntry[]

  @@index([isActive])
}

/// One player's participation in a mini-game event (attempts + win state).
model MiniGameEntry {
  id        String    @id @default(cuid())
  eventId   String
  empireId  String
  attempts  Int       @default(0)
  solved    Boolean   @default(false)
  won       Boolean   @default(false)
  wonAt     DateTime?
  /// This player's own attempt log, capped at the most recent few — the board
  /// a cracked-safe player reasons over, and what keeps a lifted cup lifted
  /// across a reload. Rows are `{kind:"cup"|"code", ...}`; see
  /// MiniGameHistoryRow in src/lib/game/minigame.ts. Private to its owner: the
  /// public rival board never carries it.
  guesses   Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event MiniGameEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, empireId])
  @@index([eventId])
}

/// Happy Hour — a global, admin-released window in which the same bonus is paid
/// to every player at once: battle XP, plunder (from raids *and* from city
/// bosses) and mine output are each multiplied by `1 + bonusPct/100`.
///
/// At most one window is live at a time (releasing one closes the rest). The
/// window is enforced on read against `startsAt`/`endsAt` — nothing runs on a
/// schedule — so a release ends on time with nobody logged in, exactly like a
/// potion. Rows are kept after they close: the lazy mine clock has to be able
/// to look *back* at a window that ended while the player was away and pay the
/// ticks that fell inside it. See src/lib/game/happyHour.ts.
model HappyHour {
  id       String @id @default(cuid())
  title    String
  /// Bonus percent on top of the ordinary figure: 100 = double, 900 = ×10.
  bonusPct Int    @default(100)

  /// Which rules the window bends. All three = "everything is doubled".
  boostXp      Boolean @default(true)
  boostPlunder Boolean @default(true)
  boostMines   Boolean @default(true)

  /// Length of a release in minutes (0 = until the admin stops it). Kept on the
  /// row so re-releasing reuses the last chosen length.
  durationMinutes Int     @default(60)
  isActive        Boolean @default(false)

  startsAt DateTime?
  /// When the window closes (null = open-ended). Stopping by hand writes `now`
  /// here too, so a closed window always has a real end for the mine backlog to
  /// measure against.
  endsAt   DateTime?
  endedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([endsAt])
}

/// Append-only trail of every mutating admin action, for accountability.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  /// e.g. "empire", "user", "season", "guild", "broadcast", "config".
  targetType String?
  targetId   String?
  /// Human-readable summary shown in the audit log UI.
  summary    String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

model GameSeason {
  id        String   @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stamped the moment the season's clock runs out and its final standings
  /// were archived. Non-null is the whole gate: a closed active season shuts
  /// every game screen until the next season opens (see server/seasonClose.ts).
  /// Writing it is the mutex — the close runs lazily on whichever page load
  /// first crosses `endsAt`, and a guarded `updateMany(closedAt: null)` makes
  /// sure only one of a hundred simultaneous loads does the archiving.
  closedAt DateTime?

  /// The end-of-season story, frozen at closing time: the categories, the
  /// totals, and the podium as it stood. Denormalised on purpose — the admin's
  /// season reset deletes every empire, so nothing on this page may be a join.
  /// Shape: `SeasonRecap` in src/server/seasonClose.ts.
  recap Json?

  empires Empire[]
}

/// One podium place of a finished season — the durable record behind היכל
/// התהילה. Written once, when the season is archived, and never updated: the
/// board is a record of who topped each season, not a live ranking.
///
/// **Nothing here is a relation, on purpose.** Not `empireId` (the next season
/// reset deletes every Empire row) and not `seasonId` (an admin may delete the
/// GameSeason itself, and the point of "save before deleting" is precisely that
/// the record outlives it). Every column is a snapshot, including the season's
/// own name and dates; the ids are historical breadcrumbs, never join keys.
/// A hall that could be emptied by a cascade would not be a hall.
model SeasonChampion {
  /// The GameSeason this was archived from. Unconstrained — the row it names
  /// may be long gone.
  seasonId       String
  seasonName     String
  seasonStartsAt DateTime
  seasonEndsAt   DateTime

  id String @id @default(cuid())

  /// 1, 2 or 3. The unique below is what makes archiving idempotent when the
  /// same season is archived twice (admin first, clock second).
  rank Int

  empireId   String?
  empireName String
  /// Owner's display name at archiving time, so the hall names a player and
  /// not only an empire.
  playerName String?
  guildName  String?

  /// Final standing figures, exactly as the ladder ranked them.
  power     Float
  cities    Int
  heroLevel Int

  /// Diamonds credited for this place when the season was sealed — the amount
  /// actually paid, not the amount the table says today, so a later change to
  /// SEASON_PRIZES never rewrites what a past champion received.
  prizeDiamonds Int       @default(0)
  /// When the prize hit the account. Null means unpaid: a row archived by the
  /// admin's "save standings" pass (which does not end the season), a champion
  /// whose empire was already gone, or a season that closed before prizes
  /// existed. It is also the guard that makes the payout idempotent.
  prizePaidAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([seasonId, rank])
  /// The hall reads newest season first.
  @@index([seasonEndsAt])
}

/// Which of היכל התהילה's three boards a row belongs to.
enum SeasonBoardKind {
  /// Strongest empires by military power — the same figure the ladder ranked by.
  POWER
  /// Best spy networks, by spy power.
  SPY
  /// Strongest guilds, by the summed military power of their members.
  GUILD
}

/// One row of one board in היכל התהילה — the durable, per-season archive behind
/// the "כוח כללי / ריגול / הברית החזקה" tables.
///
/// Same discipline as [SeasonChampion]: written once at closing time, never
/// updated, and holding no relations at all. The hall must be readable long
/// after the empires, the guilds and even the GameSeason row it names are gone,
/// so every column is a snapshot and `empireId` is a breadcrumb the profile link
/// only follows once the empire is confirmed to still exist.
///
/// It exists **because** the recap on GameSeason is not durable: that JSON dies
/// with the season row an admin may delete, and the hall may not.
model SeasonBoardEntry {
  id String @id @default(cuid())

  /// The GameSeason this was archived from. Unconstrained — the row it names
  /// may be long gone.
  seasonId       String
  seasonName     String
  seasonStartsAt DateTime
  seasonEndsAt   DateTime

  kind SeasonBoardKind
  /// 1-based place within the board. The unique below is what makes archiving
  /// idempotent when the same season is archived twice (admin, then clock).
  rank Int

  /// Empire dossier breadcrumb. Null on guild rows — a guild has no profile.
  empireId   String?
  /// Empire name, or guild name on a GUILD row.
  name       String
  /// Owner's display name at archiving time, for empire rows.
  playerName String?
  /// Secondary line: "4 ערים" for POWER, "12 חברים" for GUILD.
  note       String?

  /// What the board ranks by, floored: power, spy power, summed guild power.
  value Float

  createdAt DateTime @default(now())

  @@unique([seasonId, kind, rank])
  /// The hall reads the newest finished season only.
  @@index([seasonEndsAt])
}

model Empire {
  id                  String         @id @default(cuid())
  userId              String         @unique
  seasonId            String?
  /// Unique twice over: this `@unique` is exact-byte, and a second unique index
  /// on `lower(name)` — hand-written, because Prisma cannot declare an
  /// expression index — makes it case-insensitive too. See the
  /// case_insensitive_names migration, and normalizeName for the invisible
  /// characters neither index can see past.
  name                String         @unique
  level               Int            @default(1)
  gold                Float          @default(2000)
  wood                Float          @default(1500)
  iron                Float          @default(1000)
  stone               Float          @default(1000)
  diamonds            Float          @default(10)
  citizens            Int            @default(50)
  /// Cities the empire holds (1..MAX_CITIES). Each city adds 100 to the
  /// citizen capacity, so ten cities ceiling the population at 1,000.
  cities              Int            @default(1)
  turns               Int            @default(0)
  /// Remaining wheel-of-fortune spins. Consumed on each spin, topped up on
  /// every daily update (capped) — see WHEEL_DAILY_SPINS / WHEEL_SPINS_CAP.
  wheelSpins          Int            @default(4)
  lastRegularUpdateAt DateTime       @default(now())
  lastDailyUpdateAt   DateTime       @default(now())
  /// Last time the player opened the reports page — drives the "new reports" badge.
  reportsSeenAt       DateTime       @default(now())
  /// Heartbeat behind the chat's online dot. Stamped by the chat poll every
  /// PRESENCE_TOUCH_MS at most (a guarded updateMany that usually matches no
  /// row), so "online" means a browser actually had the game open in the last
  /// few minutes.
  ///
  /// It has to be its own column: `updatedAt` moves whenever anything writes to
  /// the empire — a plunder, an admin gift, a settle — so presence read from it
  /// would light up players who are asleep and being raided.
  lastSeenAt          DateTime?
  /// When the player collected the one-time welcome purse for joining the
  /// community channel (see /game/community). The column *is* the receipt: the
  /// claim is a single guarded UPDATE with `discordJoinedAt IS NULL` in its
  /// WHERE, so two simultaneous clicks can never both pay out.
  ///
  /// It is not proof of anything. Nothing on the Discord side reports back —
  /// there is no bot — so this records that the player pressed the button, not
  /// that they are in the room. See DISCORD_JOIN_DIAMONDS for why the purse is
  /// deliberately small.
  discordJoinedAt     DateTime?
  /// The empire that brought this player into the game — attached either by the
  /// invite link they arrived on (`/r/<code>`, the usual way) or typed in by
  /// hand from /game/referrals while they were still small. See
  /// src/lib/game/referral.ts. Null for everybody who arrived on their own.
  ///
  /// A self-relation rather than a join table: it is at most one row per empire,
  /// it is set once and never changed, and "who did I bring in" is exactly the
  /// reverse of it.
  referredById        String?
  /// When the link was attached. Distinct from `createdAt`, which is when the
  /// empire was founded: a player may arrive on their own and name a referrer
  /// on their second evening. The burst check (several invitees attached to one
  /// referrer inside a day) reads this and nothing else.
  referredAt          DateTime?
  /// How the link was attached — `"link"` for an invite URL, `"name"` for a code
  /// or empire name typed into the referrals screen. Kept for the admin review:
  /// a hand-typed link between two accounts on one device reads differently from
  /// a stranger clicking a URL.
  referralVia         String?
  /// Whether this referral may be paid, and why not. `OK` is the ordinary case
  /// — nothing suspicious, both halves collectable the moment the newcomer hits
  /// REFERRAL_GOAL_CITIES. Anything else is decided in /admin/referrals.
  ///
  /// The column gates the *payout*, never the link itself: a held referral still
  /// shows on both screens with its progress, because the overwhelmingly common
  /// cause of a hold is two real players behind one address (a household, a
  /// dorm, a carrier NAT) and telling them the friendship was rejected would be
  /// both wrong and unappealable. See src/server/referralGuard.ts.
  referralReview      ReferralReview @default(OK)
  /// The signals that fired, as `ReferralFlag` keys (src/lib/game/referral.ts).
  /// Recorded when the link is attached and re-derived at every payout attempt,
  /// so the admin queue shows what is true now rather than what was true on the
  /// day two strangers happened to share a coffee-shop IP.
  ///
  /// Defaulted to the empty array in SQL, not merely left to Prisma: a NULL
  /// scalar list is not an empty one, and array predicates against it match
  /// nothing rather than matching "no flags".
  referralFlags       String[]       @default([])
  referralReviewedAt  DateTime?
  /// The admin who cleared or killed it — a `User.id`, not a relation: this is
  /// an audit stamp beside the one in AdminAuditLog, not a graph edge, and a
  /// deleted admin must not cascade a player's referral away.
  referralReviewedBy  String?
  /// When each side of the referral was collected. The two columns ARE the
  /// receipts: each claim is a guarded UPDATE with its own column IS NULL in the
  /// WHERE, so two simultaneous clicks can never both pay out, and no separate
  /// table of claims is needed.
  ///
  /// They live on the **newcomer's** row, both of them, because a referral is a
  /// fact about the newcomer: one referrer may have many, and hanging the
  /// referrer's receipt off their own row would need a counter that says which
  /// of the invitees it was for.
  referralPaidAt      DateTime?
  referrerPaidAt      DateTime?
  /// The Jerusalem calendar day (see `gameDay` in lib/game/time.ts) whose
  /// muster roll this empire has already signed, and how many days in a row it
  /// has signed one. `streakDay` is the receipt: the claim is a guarded UPDATE
  /// with `streakDay < today` in its WHERE, so two simultaneous clicks cannot
  /// both pay out, and no separate table of claims is needed.
  ///
  /// 0 means "never claimed" — day 0 is 1970-01-01, so no live game can collide
  /// with it. A day missed does not clear these on a schedule; the *next* claim
  /// sees the gap and starts the count again. Nothing runs while the player is
  /// away, which is the whole reason this is two integers rather than a job.
  streakDay           Int            @default(0)
  streakCount         Int            @default(0)
  /// The longest run this empire has ever put together — kept when a streak
  /// breaks, so the board has something to show for the twelve days that were
  /// lost and the profile has a figure worth wearing.
  streakBest          Int            @default(0)
  /// להט הקרב — the presence boost (see src/lib/game/fervor.ts).
  ///
  /// Four columns and no job, for the same reason the streak above is two
  /// integers and no job: nothing may run while the player is away. The meter's
  /// decay is *derived* at read time by `fervorNow`, never written by a sweep.
  ///
  /// `fervorPoints` is what the meter was worth at `fervorAt` — and `fervorAt`
  /// is emphatically NOT "when the player last acted". It advances only in whole
  /// FERVOR_DECAY_MS periods, carrying the sub-period remainder forward, because
  /// decay is floored: stamping it to `now` on every action would let a player
  /// acting every 1:59 pay `floor(0.99) = 0` decay forever and pin the meter at
  /// its cap. See `bumpedFervor`, which is the only thing that may write these.
  fervorPoints        Int            @default(0)
  fervorAt            DateTime?
  /// The Jerusalem game day (`gameDay`) of the counter below, and how many
  /// winning attacks that day were already paid at the boosted rate. Same shape
  /// as `streakDay` — a stale day reads as a fresh allowance on the next attack
  /// rather than being cleared at midnight by something that has to be running.
  fervorDay           Int            @default(0)
  fervorHotAttacks    Int            @default(0)
  /// New-player shield: while this is in the future the empire cannot be
  /// attacked or spied. Set at registration; cleared early the moment the
  /// player launches their own first attack or spy (see attackEmpire/spyOnEmpire).
  protectedUntil      DateTime?
  /// Staff account: the empire exists so an admin can walk the game as a
  /// player, but it is NOT a contestant. While this is set the empire cannot be
  /// attacked or spied, and it is filtered out of every ranked or archived
  /// view — the ladders, the world records, the medal case, the guild-war
  /// roster, the season podium and the hall of fame. See src/lib/staff.ts,
  /// which owns both the guard and the `notStaff` where-fragment every board
  /// spreads in.
  ///
  /// Denormalised from `user.role` on purpose. The boards are indexed
  /// `ORDER BY … LIMIT`, and the exclusion has to be a plain column predicate
  /// on the same table or every one of them grows a join to User. Kept in step
  /// by syncStaffFlag(), which is called from the two places a role can change
  /// (the admin role editor and scripts/grant-admin.ts); a drifted flag is
  /// repaired by re-running either.
  isStaff             Boolean        @default(false)
  /// Garrison empire: nobody owns it. An admin plants it in a city tier so the
  /// players who live there — often one player alone in a high city — have
  /// something to raid and spy. It is a real empire in every respect the battle
  /// code can see: it holds a city, an army, an arsenal and a hero, it settles
  /// its own mines on the same lazy clock, and it loses resources and soldiers
  /// when it loses a fight.
  ///
  /// What it is not is a contestant. It stands in its **city ladder** (that is
  /// the whole point — a target has to be findable), and it is filtered out of
  /// everything that pays or immortalises: the season podium and its diamond
  /// prizes, היכל התהילה, the world records and the cross-game boards. See
  /// src/lib/bot.ts, which owns the `notBot` / `notStaffOrBot` where-fragments.
  ///
  /// A plain column rather than `bot != null` for the reason `isStaff` is one:
  /// the boards are indexed `ORDER BY … LIMIT` and a relation filter would turn
  /// each of them into a join. The `EmpireBot` row beside it holds the garrison
  /// this empire is rebuilt to; deleting the empire cascades it away.
  isBot               Boolean        @default(false)
  /// When this empire bought VIP (חותם המלוכה) — null for everyone else. The
  /// column IS the entitlement: it is bought once for VIP_COST diamonds and
  /// never expires, so there is no timer to read anywhere and `vipSince != null`
  /// is the whole check (see src/lib/game/vip.ts).
  ///
  /// VIP buys **convenience only** — bulk versions of things the game already
  /// lets every player do one click at a time (store/release all four
  /// warehouses, train every free citizen, raise every warehouse a level). It
  /// deliberately grants no resource, no power and no protection: a paid button
  /// that saves eight clicks is a different thing from a paid button that wins
  /// a battle, and only the first one is sold here.
  vipSince            DateTime?
  /// The תואר this empire is wearing — a key from TITLES in
  /// src/lib/game/titles.ts, or null for a player wearing none.
  ///
  /// Purely cosmetic: it appears under the name on the dossier and beside it in
  /// the ladders, and it multiplies nothing. That is the whole reason it can be
  /// sold for diamonds at all — see the note in titles.ts on why the only
  /// completely safe thing to sell is something that changes nothing.
  ///
  /// A key that has fallen out of the catalog resolves to null on read
  /// (`wornTitle`), so retiring a title needs no migration and leaves no raw
  /// key printed on anybody's dossier.
  title               String?
  /// The player's own words, shown on their dossier under the medal case. Free
  /// text up to BIO_MAX characters, written and rewritten from the profile page
  /// itself (see src/lib/game/profile.ts and saveEmpireBio).
  ///
  /// Null, never `""` — an empty submission clears the column rather than
  /// storing a blank, so "has the player written anything" is one null check on
  /// the page every player opens about everybody else.
  ///
  /// Whatever is here is public: it renders as plain text on a dossier any
  /// player can load. It is normalised on the way in (controls, bidi overrides
  /// and newline runs stripped — the same hygiene chat lines get), which bounds
  /// what it can do to the layout but says nothing about what it can say. An
  /// admin moderates an abusive one by impersonating the account and clearing
  /// the field, the way the player would.
  bio                 String?
  /// Denormalised power figures, kept in step by syncEmpirePower.
  ///
  /// These are pure functions of the army and the arsenal (see lib/game/power),
  /// but they are computed in JS, so without them no ranked query could be
  /// answered in SQL: every board had to load every empire in scope *plus every
  /// row of its arsenal*, sort in memory, and throw away all but the top rows.
  /// Storing them turns each board into an indexed ORDER BY … LIMIT.
  ///
  /// The risk they carry is drift: a write path that changes soldiers, spies or
  /// weapons and forgets to re-sync leaves a silently wrong ladder with no error
  /// anywhere. Two things contain that — every mutation goes through
  /// `syncEmpirePower`, and `applyPendingUpdates` re-derives them on every
  /// settle from data it has already loaded, so drift self-heals on the owner's
  /// next page load.
  militaryPower       Float          @default(0)
  generalPower        Float          @default(0)
  spyPower            Float          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  season        GameSeason?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  buildings     Building[]
  army          Army?
  storages      ResourceStorage[]
  upgrades      EmpireUpgrade[]
  bankAccount   BankAccount?
  weapons       EmpireWeapon[]
  weaponUnlocks EmpireWeaponUnlock[]
  hero          Hero?

  spyReportsSent     SpyReport[]         @relation("SpyAttacker")
  spyReportsReceived SpyReport[]         @relation("SpyDefender")
  sabotageSent       SabotageReport[]    @relation("SabotageAttacker")
  sabotageReceived   SabotageReport[]    @relation("SabotageDefender")
  battlesAttacked    BattleReport[]      @relation("BattleAttacker")
  battlesDefended    BattleReport[]      @relation("BattleDefender")
  messages           Message[]           @relation("MessageInbox")
  messagesSent       Message[]           @relation("MessageSender")
  chatSent           ChatMessage[]       @relation("ChatSender")
  chatReceived       ChatMessage[]       @relation("ChatRecipient")
  chatTyping         ChatTyping?
  guildMembership    GuildMember?
  guildInvites       GuildInvite[]       @relation("GuildInviteTo")
  guildInvitesSent   GuildInvite[]       @relation("GuildInviteFrom")
  guildBuffs         GuildSpellBuff[]
  diamondEffects     DiamondEffect[]
  potions            PotionStack[]
  potionEffects      PotionEffect[]
  diamondPurchases   DiamondPurchase[]
  seasonPass         SeasonPassProgress?
  bossFights         BossFight[]
  bossSieges         BossSiege[]
  bossBattles        BossBattle[]
  achievements       EmpireAchievement[]
  gloryAwards        EmpireGloryAward[]
  monuments          EmpireMonument[]
  titles             EmpireTitle[]
  worldBossStrikes   WorldBossStrike[]
  worldBossBlows     WorldBossBlow[]
  arenaEntries       ArenaEntry[]
  referredBy         Empire?             @relation("Referral", fields: [referredById], references: [id], onDelete: SetNull)
  referred           Empire[]            @relation("Referral")
  missionBoards      MissionBoard[]
  heroQuest          HeroQuest?
  bot                EmpireBot?

  // Rankings filters empires by city; admin broadcast/gift/reset scope by
  // season. Without these, both are full-table scans that grow with the player
  // base. The composite also serves the (now-removed) stale-daily settle query.
  @@index([cities, lastDailyUpdateAt])
  @@index([seasonId])
  /// The city ladder: rank inside one city tier.
  @@index([cities, militaryPower])
  /// The cross-game boards.
  @@index([generalPower])
  @@index([spyPower])
  /// The chat roster: who is online, then who was here most recently.
  @@index([lastSeenAt])
  /// Staff are a handful of rows, but every board now carries `isStaff: false`
  /// in its WHERE. This keeps the ladders' ORDER BY servable from an index
  /// with the predicate already applied instead of filtered on the heap.
  @@index([isStaff, generalPower])
  @@index([isStaff, spyPower])
  @@index([isStaff, cities, militaryPower])
  /// "Who did I bring in" — the referrals page's only read.
  @@index([referredById])
  /// The admin review queue: the handful of held referrals, newest first.
  @@index([referralReview, referredAt])
}

/// Whether a referral may be paid — see `Empire.referralReview`.
enum ReferralReview {
  /// Nothing suspicious. Both halves pay on reaching the goal.
  OK
  /// A signal fired. The link stands and the progress is shown, but neither
  /// half pays until an admin looks. This is the *only* thing a soft signal
  /// (shared address, a burst of invitees, combat between the pair) does.
  HELD
  /// An admin looked and it is a real friendship. Pays like OK, and stays
  /// APPROVED so a later re-derivation of the flags cannot re-hold it.
  APPROVED
  /// An admin looked and it is a farm. Never pays, and cannot be re-opened by
  /// the players — only by an admin changing their mind.
  REJECTED
}

/// The garrison a bot empire is rebuilt to — one row per `Empire.isBot`.
///
/// A bot exists to be attacked, and an attack takes things: a winning raid
/// plunders its vaults and enslaves a tenth of its soldiers. Left alone that
/// makes every bot a one-week target that decays into an empty shell, and the
/// admin who planted it has to come back and re-arm it by hand.
///
/// So the garrison is stored rather than merely created: these columns are the
/// figures the bot was *built* with, and `restoreBotGarrison` (src/server/bots.ts)
/// sets the army and the arsenal back to them at most once per BOT_RESTORE_MS,
/// on the same lazy clock that settles the bot's mines — which runs precisely
/// when someone loads the bot as a target. The bot's *resources* are pointedly
/// not restored: those come from its own mines through the ordinary economy, so
/// a bot is never a faucet that mints gold on a timer.
///
/// `restoredAt` is the concurrency story as well as the clock. The refill claims
/// it with an `updateMany` guarded on the exact timestamp that was read, so two
/// raiders arriving at the same moment cannot both rebuild the same garrison.
model EmpireBot {
  id       String @id @default(cuid())
  empireId String @unique

  /// Military power the garrison below fields, for the admin list. Every bot is
  /// planted with the same fixed garrison (see BOT_SOLDIERS), so this is now the
  /// bodies alone — the column is kept because it is what the list prints and
  /// because a garrison that carries weapons again would need it.
  targetPower Float

  /// The garrison itself, exactly as it is written back on a refill.
  soldiers       Int
  spies          Int
  /// Weapon tier the three stacks below are recorded at — the highest tier this
  /// empire's city and hero level would legitimately unlock (weaponTierGate).
  /// Bots buy none, so the three quantities are zero.
  weaponTier     Int
  attackWeapons  Int
  defenseWeapons Int
  spyWeapons     Int

  /// Last time the garrison was written back. See the note above.
  restoredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)
}

/// A single collected achievement. The row IS the receipt: nothing is written
/// until the player presses "collect".
///
/// Deliberately there is no progress column. Every achievement's condition is
/// *derived on read* from data the game already stores (battle reports, spy
/// reports, buildings, army, hero items…), so no gameplay action has to be
/// instrumented to keep a counter in sync — and a condition can be retuned in
/// src/lib/game/achievements.ts without a backfill. See
/// src/server/actions/achievements.ts.
///
/// The composite unique is the whole concurrency story: claiming inserts the
/// row first and lets the constraint reject a duplicate, so two simultaneous
/// clicks can never both pay out.
model EmpireAchievement {
  id        String   @id @default(cuid())
  empireId  String
  /// Catalog key from ACHIEVEMENTS. Kept as a plain string rather than an enum
  /// so adding an achievement is a code change, not a migration. Keys that fall
  /// out of the catalog are ignored on read.
  key       String
  claimedAt DateTime @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  // Also serves the "which has this empire claimed" read — no separate index needed.
  @@unique([empireId, key])
}

/// Automatic world decorations — the capstone board on /game/base.
///
/// Deliberately NOT EmpireAchievement. That ladder is *collected*: reaching a
/// goal only unlocks a button, and the reward is paid when the player presses
/// it. These are decorations, not rewards — they light up on their own the
/// moment the empire meets the condition, and there is nothing to press and
/// nothing to pay out. Sharing the achievements table would have meant a player
/// who hit a ceiling and left the reward sitting was shown as not having done
/// it, and would have lost the world record to whoever clicked first.
///
/// A row is stamped the first time the empire is *observed* meeting the
/// condition (see src/server/gloryBoard.ts). `awardedAt` is therefore the
/// arrival time to the nearest page load, which is what makes the earliest row
/// per key a fair world record.
model EmpireGloryAward {
  id        String   @id @default(cuid())
  empireId  String
  /// Key from GLORY_KEYS in src/lib/game/achievements.ts. A plain string for
  /// the same reason EmpireAchievement.key is: adding a capstone is a code
  /// change, not a migration. Keys that fall out of the set are ignored on read.
  key       String
  awardedAt DateTime @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  // Idempotent awarding: the writer inserts unconditionally and lets this
  // constraint drop the repeat, so two concurrent observations cannot both
  // stamp — and the first stamp is the one that survives.
  @@unique([empireId, key])
  // "Who got here first, server-wide". The unique above starts on empireId, so
  // a key-filtered lookup cannot use it; without this the board sequentially
  // scans on every base-screen load. Ordering by awardedAt makes each record a
  // one-row index read.
  @@index([key, awardedAt])
}

/// A monument raised in the capital — the endgame's gold sink.
///
/// One row per monument an empire has founded; a monument nobody has built has
/// no row, which is why the read side defaults a missing key to level 0 rather
/// than seeding five rows per empire.
///
/// `key` is a plain string rather than an enum for the reason
/// EmpireAchievement.key is one: adding or retiring a monument is a code
/// change, not a migration, and a key that falls out of the catalog is ignored
/// on read. See src/lib/game/monuments.ts — and note the rule stated there that
/// no monument may touch combat power.
model EmpireMonument {
  id       String @id @default(cuid())
  empireId String
  key      String
  /// 1..MONUMENT_MAX_LEVEL. A row exists only once the monument is founded, so
  /// this is never 0.
  level    Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  // Also serves "this empire's monuments", which is the only read.
  @@unique([empireId, key])
}

/// A **bought** title's receipt.
///
/// Earned titles deliberately have no row here: their condition is re-derived
/// on every read from the same lifetime-counters snapshot the achievements
/// ladder uses, so adding one needs no backfill and retiring one leaves nothing
/// behind. Only a purchase is recorded, because only a purchase is a fact about
/// money rather than a fact about play.
///
/// Buying is permanent and separate from wearing: an empire owns every title it
/// has paid for and wears at most one (`Empire.title`), so a player can change
/// their mind without paying again.
model EmpireTitle {
  id       String @id @default(cuid())
  empireId String
  /// Key from TITLES in src/lib/game/titles.ts. A plain string for the reason
  /// EmpireAchievement.key is one; unknown keys are ignored on read.
  key      String
  /// Diamonds actually paid, frozen at purchase. Kept so a later retune of the
  /// price does not rewrite history in the admin's ledger view.
  paid     Int    @default(0)

  boughtAt DateTime @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  // The receipt IS the guard: the purchase inserts unconditionally and lets
  // this constraint drop a double-click, so nobody can be charged twice for one
  // title. Also serves "which titles does this empire own".
  @@unique([empireId, key])
}

/// מפלצת העולם — one enemy the whole server fights at once.
///
/// A **fixture, not an event**: exactly one row per Jerusalem week, created
/// lazily the first time anybody opens the arena that week. There is no admin
/// button and no scheduler — which boss appears is a pure function of the week
/// (see rollWorldBoss), so every player computes the same answer with no writer
/// and the unique index below drops whichever concurrent first-load loses.
model WorldBoss {
  id   String @id @default(cuid())
  /// Jerusalem week index — see `gameWeek` in lib/game/time.ts.
  week Int    @unique
  /// Catalog key from WORLD_BOSSES. Ignored on read if it falls out.
  key  String

  /// Frozen at spawn from the empire count, never recomputed: a boss that grew
  /// because somebody registered on Thursday would punish the server for
  /// growing. See worldBossMaxHp.
  maxHp Float
  /// Remaining health. Driven to zero by guarded decrements — the strike that
  /// takes it to 0 is the one that stamps `defeatedAt`, so the kill is a
  /// transition rather than a comparison and exactly one striker can win it.
  hp    Float

  defeatedAt DateTime?
  /// The empire that landed the killing blow. Not a relation: the empire may be
  /// deleted at a season restart while the row is still being read, and a
  /// dangling name is a better outcome than a cascade that erases the kill.
  slayerId   String?
  slayerName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strikes WorldBossStrike[]
  blows   WorldBossBlow[]
}

/// One blow, kept as its own row so the arena can show the fight *happening*.
///
/// WorldBossStrike is an aggregate — a running total per empire — and a total
/// cannot say whether anybody is in the arena right now. This is the ledger
/// behind the live feed: the last dozen blows the server landed, newest first.
///
/// Names are denormalised for the reason WorldBoss.slayerName is: the feed is
/// read on a poll, and a season wipe may remove the empire while the row is
/// still being displayed. Rows are never pruned — one week of one boss is at
/// most WORLD_BOSS_MAX_STRIKES per empire, and the season wipe takes the boss
/// and its blows together.
model WorldBossBlow {
  id       String @id @default(cuid())
  bossId   String
  empireId String

  /// Frozen at the moment of the blow — see above.
  empireName String
  title      String?

  damage Float
  /// The beast's health after this blow, so the feed reads as a descent rather
  /// than as a list of unrelated numbers.
  hpAfter Float
  /// This blow was the kill. Exactly one row per boss can carry it, for the
  /// same reason WorldBoss.defeatedAt can only be stamped once.
  slaying Boolean @default(false)

  createdAt DateTime @default(now())

  boss   WorldBoss @relation(fields: [bossId], references: [id], onDelete: Cascade)
  empire Empire    @relation(fields: [empireId], references: [id], onDelete: Cascade)

  /// The feed: "this boss's blows, newest first".
  @@index([bossId, createdAt])
}

/// One empire's running total against one world boss.
///
/// A real counter rather than a derived figure, for the reason the guild
/// contract is one: the alternative is summing a row per blow across the whole
/// server on every page load. Both columns only ever rise.
model WorldBossStrike {
  id       String @id @default(cuid())
  bossId   String
  empireId String

  /// Damage this empire has dealt in total.
  damage Float @default(0)
  /// Blows landed — capped at WORLD_BOSS_MAX_STRIKES, which is what stops the
  /// board from being a copy of the power ladder.
  hits   Int   @default(0)

  /// The spoils have been collected. The flag IS the receipt: the claim is a
  /// guarded UPDATE with `claimed = false` in its WHERE, so two simultaneous
  /// clicks cannot both pay out.
  claimed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boss   WorldBoss @relation(fields: [bossId], references: [id], onDelete: Cascade)
  empire Empire    @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([bossId, empireId])
  /// The damage board: "this boss's strikers, hardest first".
  @@index([bossId, damage])
}

/// הזירה — the weekly tournament, one per city tier.
///
/// Fought by the system rather than by players, like the guild war: entrants
/// register during the week, and when the week turns over the whole card is
/// resolved at once — every entrant against every other, exactly once.
///
/// A **fixture, not an event**: the row is created lazily on the first look of
/// the week, and which duels happen is a pure function of who entered (see
/// resolveArena), so there is no bracket to hold and nothing half-finished to
/// repair if an account is deleted mid-week.
model Arena {
  id   String @id @default(cuid())
  /// Jerusalem week index — see `gameWeek` in lib/game/time.ts.
  week Int
  /// City tier. Combat never crosses one anywhere else in the game, and a
  /// tournament that ignored that would be won by the largest empire forever.
  tier Int

  /// Stamped by the resolution. The transition — not the clock — is what makes
  /// the table final, and the guarded UPDATE that sets it filters on
  /// `resolvedAt IS NULL`, so a card cannot be fought twice.
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries ArenaEntry[]

  @@unique([week, tier])
}

/// One empire's entry in one arena, and its record once the card is fought.
model ArenaEntry {
  id       String @id @default(cuid())
  arenaId  String
  empireId String

  /// Military power at the moment of resolution, frozen onto the row. Read live
  /// rather than at registration on purpose: an empire that grew during the week
  /// should fight with the army it actually has, and freezing at sign-up would
  /// reward entering early over playing.
  power  Float @default(0)
  wins   Int   @default(0)
  losses Int   @default(0)
  /// 1-based placing; 0 until the card is resolved.
  place  Int   @default(0)

  /// The spoils have been collected. The flag IS the receipt — a guarded UPDATE
  /// with `claimed = false` in its WHERE.
  claimed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arena  Arena  @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([arenaId, empireId])
  /// The table: "this arena's entrants, best first".
  @@index([arenaId, place])
}

enum MissionScope {
  DAY
  WEEK
}

/// One player's mission board for one period — the daily three and the weekly
/// three (see src/lib/game/missions.ts).
///
/// The row holds no counters. Progress on a mission is `now − baseline`, where
/// `baseline` is the same lifetime-stats snapshot the achievements ladder is
/// evaluated against, frozen the first time the board was opened this period.
/// That is what makes the whole feature possible without instrumenting a single
/// gameplay action: attacking, spying, training and banking all already move
/// counters the snapshot query reads, so a mission is a *difference* rather than
/// a tally somebody has to remember to increment.
///
/// The consequence to know: a board that is first opened late in the day
/// baselines late, so only what happens *after* that counts. That is deliberate
/// — the alternative is a board that pays out for a morning the player never
/// spent on it — and it is why the board is created on the first read of the
/// day (see openMissionBoard) rather than on the first claim.
model MissionBoard {
  id       String       @id @default(cuid())
  empireId String
  scope    MissionScope
  /// The period this board belongs to: a Jerusalem day index for DAY, a
  /// Jerusalem week index for WEEK (see `gameDay` / `gameWeek`).
  period   Int

  /// Catalog keys rolled for this board, in display order. Rolled
  /// deterministically from (empireId, scope, period) — see rollMissions — so
  /// two requests racing to open the same board write the same three missions
  /// and the unique index below can drop the loser harmlessly.
  missions String[]
  /// Keys already collected from this board. A claim appends under a guard on
  /// the array's own contents, so a double tap cannot pay twice.
  claimed  String[]

  /// The counters as they stood when the board opened. Shape: MissionBaseline
  /// in src/lib/game/missions.ts — a plain flat object of numbers, read back
  /// defensively (a key the catalog has since added simply reads as 0).
  baseline Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, scope, period])
}

/// The guild's shared daily goal — one row per guild per Jerusalem day.
///
/// Unlike a mission board this one *is* a counter, and it has to be: the
/// baseline trick works because a single empire's lifetime totals are one cheap
/// query, and summing that over every member on every page load is not. Members
/// contribute by claiming their own daily missions — each claim credits the
/// contract (see claimMission) — so the increment rides a path that is already
/// transactional, already guarded and already once-per-mission.
model GuildContract {
  id      String @id @default(cuid())
  guildId String
  /// Jerusalem day index — the same clock the personal board runs on.
  day     Int

  /// Catalog key from GUILD_CONTRACTS, rolled deterministically from
  /// (guildId, day) so every member sees the same contract without a writer.
  key      String
  /// Missions the guild's members have completed today, against `goal`.
  progress Int    @default(0)
  /// Frozen at creation from the guild's member count: a contract that grew
  /// harder because somebody joined at 23:00 would be a punishment for
  /// recruiting. See guildContractGoal.
  goal     Int

  /// Set the moment `progress` first reaches `goal`. The transition — not the
  /// comparison — is what pays every member, and it happens exactly once
  /// because the guarded UPDATE that stamps it also filters on `completedAt IS
  /// NULL`.
  completedAt DateTime?

  /// Empire ids already paid for this contract. Members who join after it
  /// completed are not owed anything, and a member who was paid cannot be paid
  /// again by re-opening the page.
  paid String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, day])
}

/// Per-empire season-pass state. Exactly one row per empire, reset in place on
/// each daily-update boundary rather than re-created — see
/// src/server/actions/seasonPass.ts.
model SeasonPassProgress {
  id       String @id @default(cuid())
  empireId String @unique

  /// Season the `premium` flag and progress belong to. When the active season
  /// changes, the row is wiped back to a free, zeroed ladder — premium is
  /// bought per season, so a new season means buying again.
  seasonId String?

  /// Premium track purchased. Survives every cycle reset within the season, so
  /// the player is charged once and keeps the gold track open all season.
  premium   Boolean   @default(false)
  premiumAt DateTime?

  /// The daily-update boundary this ladder belongs to. Once
  /// `lastDailyUpdate(now)` moves past it, `xp` and both claimed lists reset
  /// and the payouts grow with the new season day.
  cycleStartedAt DateTime

  /// XP earned in the current cycle only. Tier N unlocks at N × 50.
  xp Int @default(0)

  /// Tiers already collected in the current cycle, per track. Claiming pushes
  /// onto these under a `NOT has` guard, which is what makes a double-claim
  /// impossible without a row lock.
  claimedFree    Int[]
  claimedPremium Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)
}

/**
 * --------------------------- diamond store (real money) ---------------------------
 */

/// Lifecycle of a real-money diamond-package purchase.
enum PurchaseStatus {
  /// Charge created with the provider, not yet confirmed.
  PENDING
  /// Charge succeeded and the diamonds were credited.
  PAID
  /// Charge failed or was declined — no diamonds credited.
  FAILED
  /// A settled charge was refunded or reversed by the provider (gateway refund
  /// or chargeback). The diamonds are NOT clawed back automatically — a balance
  /// can already have been spent — so an admin decides what to adjust.
  REFUNDED
}

/// One real-money purchase attempt of a diamond package — a full financial
/// audit row. Created PENDING, then settled to PAID (diamonds credited in the
/// same transaction) or FAILED by the payment provider result.
///
/// Everything needed to read a receipt is snapshotted at purchase time, because
/// (a) packages live in code (DIAMOND_PACKAGES), not in rows, and (b) the buyer
/// or their empire may later be renamed or deleted. `empireId` is therefore
/// nullable with onDelete: SetNull — deleting an account never erases its
/// purchase history. `isTest` marks charges that moved no real money (the mock
/// provider), so real revenue can be reported separately.
model DiamondPurchase {
  id            String         @id @default(cuid())
  empireId      String?
  /// Snapshot of the buyer's user id (survives empire/account deletion).
  userId        String?
  /// Snapshot of the buyer's email at purchase time (for receipts/support).
  userEmail     String?
  /// Snapshot of the empire name at purchase time.
  empireName    String?
  /// Package id from DIAMOND_PACKAGES.
  packageId     String
  /// Total diamonds granted (base + bonus), snapshotted at purchase time.
  diamonds      Int
  /// Base diamonds of the package (without the bonus).
  baseDiamonds  Int            @default(0)
  /// Bonus diamonds thrown in on top.
  bonusDiamonds Int            @default(0)
  /// Price actually charged, after any admin discount.
  priceIls      Float
  /// Full list price before the admin discount (for the receipt).
  basePriceIls  Float          @default(0)
  /// Discount percent applied at purchase time.
  discountPct   Float          @default(0)
  /// ISO-4217 currency of the charge.
  currency      String         @default("ILS")
  /// Payment provider that handled the charge ("mock" until a real one is wired).
  provider      String
  /// Provider-side transaction reference, once charged. Unique so the same
  /// reference can never settle twice: today's in-process flow is idempotent on
  /// the internal purchase id, but the documented go-live path is a provider
  /// webhook, and a replayed webhook carrying a reference we have already
  /// credited would otherwise settle a second row and double-credit diamonds.
  /// The future webhook handler must look the purchase up BY THIS FIELD.
  providerRef   String?        @unique
  /// Provider-side id of the money movement itself — the *capture*, which is
  /// what a refund is issued against and what refund/chargeback callbacks
  /// identify the payment by (`providerRef` holds the order id).
  /// Unique for the same anti-replay reason as `providerRef`.
  captureRef    String?        @unique
  /// Provider-side secret needed to *query* this order (Grow's `processToken`).
  /// Stored so settlement can re-ask the gateway what the order is really worth
  /// instead of believing an unsigned callback or a browser query string — see
  /// `src/server/grow.ts`. Deliberately NOT unique: it is a credential, not an
  /// identifier, and a uniqueness collision here would reject a valid payment.
  providerToken String?
  /// True when no real money moved (the mock provider).
  isTest        Boolean        @default(false)
  status        PurchaseStatus @default(PENDING)
  /// Why the charge failed (only set on FAILED).
  failureReason String?
  /// When the charge settled as PAID.
  paidAt        DateTime?
  /// When a settled charge was refunded or reversed.
  refundedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  empire Empire? @relation(fields: [empireId], references: [id], onDelete: SetNull)

  @@index([empireId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/**
 * ------------------------------ diamond shop ------------------------------
 */

/// A purchasable diamond effect on an empire. Timed buffs (resource boosts,
/// shop discount) use `magnitude` + `activeUntil`; cooldown-only spells
/// (bank interest) use `readyAt`. One row per (empire, kind).
enum DiamondEffectKind {
  RESOURCE_BOOST_GOLD
  RESOURCE_BOOST_WOOD
  RESOURCE_BOOST_IRON
  RESOURCE_BOOST_STONE
  SHOP_DISCOUNT
  BANK_INTEREST
  TURN_PACK_1
  TURN_PACK_2
  TURN_PACK_3
  TURN_PACK_4
  /// Paid raid shields: while active, a winning attacker takes no plunder
  /// (RESOURCES) / captures no soldiers (SOLDIERS) from this empire.
  SHIELD_RESOURCES
  SHIELD_SOLDIERS
  /// Cooldown of the city-downgrade spell (gives up one city tier, once/hour).
  CITY_DOWNGRADE
}

model DiamondEffect {
  id          String            @id @default(cuid())
  empireId    String
  kind        DiamondEffectKind
  /// Boost/discount percent (0 for cooldown-only spells).
  magnitude   Float             @default(0)
  /// When a timed buff expires (null for cooldown-only spells).
  activeUntil DateTime?
  /// When a cooldown-only spell becomes usable again (null for buffs).
  readyAt     DateTime?
  updatedAt   DateTime          @updatedAt
  createdAt   DateTime          @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, kind])
  @@index([empireId, activeUntil])
}

/**
 * ------------------------------ guilds ------------------------------
 */

enum GuildRole {
  LEADER
  DEPUTY
  MEMBER
}

/// The guild spells sold in the guild shop. Each has a per-guild level
/// (level = bonus %, starts at 1, capped per spell — see lib/game/guild.ts)
/// that members upgrade with diamonds; casting one grants the caster a
/// personal buff for that spell's window.
///
/// `SPY` was removed on 2026-08-03 — the guild had no business tilting spy
/// missions, which are decided by intelligence power alone.
enum GuildSpellType {
  ATTACK
  DEFENSE
  RESOURCES
}

model Guild {
  id            String   @id @default(cuid())
  /// Case-insensitively unique as well — same arrangement as Empire.name.
  name          String   @unique
  /// Member capacity = 1 + level, so a fresh guild (level 1) holds 2 members.
  capacityLevel Int      @default(1)
  /// Guild aid level — each level adds 1% of the guild's total military power
  /// as flat combat power for every member in battle, up to 10%. Paid out of
  /// the treasury below by a leader or deputy.
  aidLevel      Int      @default(0)
  /// אוצר הברית — gold the members have donated, and the only thing the guild's
  /// two ladders are bought with.
  ///
  /// Both ladders used to be paid out of whichever member happened to want the
  /// upgrade, which made every guild improvement one person's charity and gave
  /// nobody else a reason to care. A treasury turns the same two ladders into a
  /// shared project: everyone can put gold in, the leadership decides what it
  /// buys, and the board shows who carried the guild.
  ///
  /// A Float, matching `Empire.gold` — the two are transferred between each
  /// other and a type mismatch would round somebody's donation.
  treasury      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members   GuildMember[]
  spells    GuildSpell[]
  invites   GuildInvite[]
  contracts GuildContract[]
}

/// A standing invitation for one guildless empire to join one guild.
///
/// Joining is invitation-only: `joinGuild` consumes a live row here, so the
/// browse list on /game/guild is a directory, not a door. The invitation used
/// to be nothing but an inbox message, which meant the message was decoration —
/// the join action never looked at it, and anyone holding a guild id could walk
/// into any guild uninvited.
model GuildInvite {
  id          String   @id @default(cuid())
  guildId     String
  empireId    String
  /// Who sent it. SetNull so a deleted recruiter does not void the invitation.
  invitedById String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  guild     Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  empire    Empire  @relation("GuildInviteTo", fields: [empireId], references: [id], onDelete: Cascade)
  invitedBy Empire? @relation("GuildInviteFrom", fields: [invitedById], references: [id], onDelete: SetNull)

  /// One standing invitation per guild per player — re-inviting refreshes it.
  @@unique([guildId, empireId])
  @@index([empireId, expiresAt])
}

model GuildMember {
  id        String    @id @default(cuid())
  guildId   String
  empireId  String    @unique
  role      GuildRole @default(MEMBER)
  /// Lifetime gold this member has put into the treasury.
  ///
  /// The socially load-bearing number, and the reason it is stored rather than
  /// derived from a ledger: what a guild actually argues about is who carried
  /// it, and that question has to be answerable on the guild screen without a
  /// scan. It only ever rises, and it is deliberately NOT reduced when the
  /// treasury is spent — it records what this member gave, not what is left.
  ///
  /// Resets to zero on leaving, along with the row itself. A member who leaves
  /// and rejoins starts their contribution again, which is the honest reading:
  /// they are contributing to the guild they are in now.
  donated   Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model GuildSpell {
  id        String         @id @default(cuid())
  guildId   String
  type      GuildSpellType
  level     Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, type])
}

/// An active (or expired, until cleaned up) spell buff on an empire. Both the
/// bonus % and the expiry are snapshotted at cast time, so the buff survives
/// the caster leaving the guild — or the shop's ceiling moving under it.
model GuildSpellBuff {
  id        String         @id @default(cuid())
  empireId  String
  type      GuildSpellType
  bonusPct  Float
  expiresAt DateTime
  createdAt DateTime       @default(now())

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@index([empireId, expiresAt])
}

/**
 * ---------------------------- guild war ----------------------------
 */

enum GuildWarStatus {
  /// Registered, running, or waiting to be settled.
  SCHEDULED
  /// Finished with enough guilds; ranks and prizes are written.
  SETTLED
  /// Finished with fewer than GUILD_WAR_MIN_GUILDS entrants. Nobody scores,
  /// nobody is paid — a single guild showing up wins nothing.
  CANCELLED
}

/// One nightly guild campaign: a 30-minute window (19:30-20:00 Jerusalem) that
/// the game fights **by itself**. Guilds enrol and then watch: every minute the
/// system throws one clash per guild, resolves it with the real battle maths
/// and posts it to the live feed. No player ever presses anything.
///
/// Rows are created lazily by the first guild to register, advanced lazily by
/// any request that arrives during the window, and settled lazily by the first
/// one after it closes. The game has no cron and nothing here may assume one.
model GuildWar {
  id             String         @id @default(cuid())
  /// Window open. Unique so concurrent registrations converge on one row per
  /// night instead of racing two wars into existence.
  startsAt       DateTime       @unique
  endsAt         DateTime
  status         GuildWarStatus @default(SCHEDULED)
  /// How many of the GUILD_WAR_ROUNDS minute-rounds have been fought. This is
  /// the resume point for the lazy simulation: a request materialises every
  /// round that has come due since, under a row lock and guarded on this
  /// counter, so two readers arriving together can never fight one round twice.
  resolvedRounds Int            @default(0)
  settledAt      DateTime?
  createdAt      DateTime       @default(now())

  entries GuildWarEntry[]
  clashes GuildWarClash[]

  /// Drives both the "wars in progress" and "wars due for settlement" sweeps.
  @@index([status, endsAt])
}

/// A guild's enrolment in one war, and its running score.
model GuildWarEntry {
  id        String @id @default(cuid())
  warId     String
  /// Soft reference - deliberately no foreign key. A guild that disbands the
  /// morning after must not erase the night it won, so the war keeps its own
  /// snapshot of the name and simply finds no members left to pay.
  guildId   String
  guildName String

  score  Int @default(0)
  /// Clashes this guild won — broke through as attacker, or held as defender.
  wins   Int @default(0)
  /// Clashes it lost on either side.
  losses Int @default(0)

  /// The guild's combined military power, snapshotted at enrolment and
  /// refreshed on every round the simulation materialises.
  ///
  /// Stored rather than computed on read because the board polls every six
  /// seconds and summing it live means loading every member's army and every
  /// weapon row on each poll. advanceWar already has the figures in hand.
  ///
  /// Float, like every other power column: weapon power grows 2.5× per tier, so
  /// a mid-game guild's summed power passes the 2^31 ceiling of an Int easily.
  power Float @default(0)

  /// Final placement, written at settlement (1 = champion).
  rank        Int?
  /// Prize snapshot, written at settlement so the result page reads the same
  /// after the prize table is retuned.
  rewardLabel String?

  createdAt DateTime @default(now())

  war GuildWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@unique([warId, guildId])
  @@index([warId, score])
}

/// One clash the system fought inside a war — the live feed, and the source of
/// every score. Both sides are snapshotted so the war reads the same a month
/// later, whoever has since left, renamed or disbanded.
model GuildWarClash {
  id    String @id @default(cuid())
  warId String
  /// Which minute of the campaign this was fought in (0-based).
  round Int

  attackerGuildId   String
  attackerGuildName String
  defenderGuildId   String
  defenderGuildName String

  attackerEmpireId String
  attackerName     String
  defenderEmpireId String
  defenderName     String

  attackerPower Float
  defenderPower Float
  /// True when the attacker broke through. Points go to the attacker on a
  /// breakthrough and to the defender on a hold — one field, two owners.
  won           Boolean
  points        Int

  /// The round's scheduled instant, not the moment the row was written: rounds
  /// are materialised late whenever nobody was watching, and a feed stamped
  /// with the catch-up time would show half an hour of war in one second.
  createdAt DateTime

  war GuildWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  /// The live feed.
  @@index([warId, createdAt])
  /// Idempotent catch-up + the per-round replay.
  @@index([warId, round])
  /// The fighter board.
  @@index([warId, attackerEmpireId])
  @@index([warId, defenderEmpireId])
}

enum MessageKind {
  SYSTEM
  BATTLE
  SPY
  /// Player-to-player mail, written from the messages screen.
  PLAYER
}

/// Inbox message for an empire — system announcements, combat alerts
/// ("you were attacked", "a spy was caught in your territory") and mail sent
/// by other players.
model Message {
  id             String      @id @default(cuid())
  empireId       String
  /// Author of a PLAYER message. Null for anything the game itself wrote.
  /// SetNull (not Cascade) so a deleted sender does not erase the recipient's
  /// inbox — the message survives as "שחקן שנמחק".
  senderEmpireId String?
  kind           MessageKind @default(SYSTEM)
  title          String
  body           String
  /// Optional in-game link, e.g. the full battle report page.
  href           String?
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  empire Empire  @relation("MessageInbox", fields: [empireId], references: [id], onDelete: Cascade)
  sender Empire? @relation("MessageSender", fields: [senderEmpireId], references: [id], onDelete: SetNull)

  @@index([empireId, readAt])
  @@index([empireId, createdAt])
  @@index([senderEmpireId, createdAt])
}

enum HeroRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

/// The character archetype chosen at signup — each carries its own passive
/// bonus (see HERO_CLASS_META in src/lib/game/hero.ts).
enum HeroClass {
  WARLORD
  GUARDIAN
  MERCHANT
  SHADOW
}

enum HeroItemSlot {
  SWORD
  GAUNTLETS
  WINGS
  HELMET
  ARMOR
  SHIELD
  PANTS
  BOOTS
  RELIC
}

model Hero {
  id                  String    @id @default(cuid())
  empireId            String    @unique
  heroClass           HeroClass @default(WARLORD)
  level               Int       @default(1)
  xp                  Int       @default(0)
  /// Points earned and not yet allocated. A newborn hero already holds one:
  /// the pool is one point per level he *stands at* (level 1 included) plus 30
  /// for every reset behind him — see heroPointPool in src/lib/game/hero.ts,
  /// which applyPendingUpdates reconciles this row against on every load.
  unspentPoints       Int       @default(1)
  attackPoints        Int       @default(0)
  defensePoints       Int       @default(0)
  resourcePoints      Int       @default(0)
  resets              Int       @default(0)
  /// Hero health, 0–100. Every attack that breaches this empire's defence
  /// wounds the hero (see HERO_DAMAGE_PER_LOST_DEFENSE); at 0 he is dead.
  health              Int       @default(100)
  /// When the hero fell (health hit 0), else null. He rises by himself an hour
  /// later — applied lazily by applyPendingUpdates — or instantly for diamonds.
  /// While dead he grants **no** bonuses at all (see heroBonuses).
  diedAt              DateTime?
  /// רסיסי ציוד — the forge's currency, earned by dismantling gear and spent on
  /// commissioning a slot or tempering a piece (see src/lib/game/forge.ts).
  ///
  /// On the hero rather than the empire because it is gear, and because it must
  /// survive a prestige: a reset takes the level back to 1 and leaves the bag
  /// alone, so taking the shards would be taking gear the player still holds.
  ///
  /// Deliberately flat-valued (a פשוט is one shard from any decade) — the note
  /// in forge.ts explains why a decade-scaled shard has an arbitrage in it.
  shards              Int       @default(0)
  /// The season in which the diamond points-reset was last used (once/season).
  pointsResetSeasonId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  empire Empire     @relation(fields: [empireId], references: [id], onDelete: Cascade)
  items  HeroItem[]
}

model HeroItem {
  id        String       @id @default(cuid())
  heroId    String
  slot      HeroItemSlot
  level     Int
  rarity    HeroRarity
  equipped  Boolean      @default(false)
  createdAt DateTime     @default(now())

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId])
}

/// The expedition the hero is currently away on, or the finished one waiting to
/// be collected. Catalog and every balance formula: src/lib/game/heroQuests.ts.
///
/// **At most one row per empire, and that is the feature's core rule** — there
/// is one hero, so he can only be in one place. The unique index on `empireId`
/// is what enforces it: `startHeroQuest` also takes the empire row lock before
/// it checks, but the index is the backstop that holds even if a future caller
/// forgets to.
///
/// The payout is snapshotted at *departure* rather than derived on collect, so
/// the board can promise an exact haul before the player commits turns to it,
/// and a city founded (or lost) mid-quest cannot change the deal. The loot roll
/// is the one thing left to collect time — it needs the hero's level *then*.
///
/// The row IS the claim: collecting deletes it under a guard on `endsAt`, so a
/// double-click cannot pay twice.
model HeroQuest {
  id       String @id @default(cuid())
  empireId String @unique

  /// Quest tier (1..MAX_CITIES) — decides duration, turn cost, XP and loot odds.
  tier Int

  startedAt  DateTime @default(now())
  endsAt     DateTime
  turnsSpent Int

  /// The haul, rolled and frozen at departure — never sent to the client, so
  /// the board cannot leak what is coming (see lib/game/heroQuests.ts).
  /// `fortune` is the luck band that was drawn; the homecoming line names it.
  fortune        String @default("plain")
  rewardGold     Float  @default(0)
  rewardWood     Float  @default(0)
  rewardIron     Float  @default(0)
  rewardStone    Float  @default(0)
  rewardCitizens Int    @default(0)
  rewardSlaves   Int    @default(0)
  rewardXp       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)
}

/**
 * ------------------------------ potions ------------------------------
 */

/// The four brews looted from won battles. Each is a *timed* effect on the
/// whole empire, not an item: drinking one starts (or extends) a window, and
/// everything else in the game only ever asks "is this kind active right now?".
/// Catalog, durations and drop odds: src/lib/game/potions.ts.
enum PotionKind {
  DOUBLE_XP
  DOUBLE_RESOURCES
  HERO_INVULNERABLE
  FORGE_DISCOUNT
}

/// Unopened potions on the belt — one row per (empire, kind) holding how many
/// are in hand. Counts, not one row per bottle: potions are fungible and the
/// belt shows a stack with a badge, so a row per bottle would buy nothing.
model PotionStack {
  id        String     @id @default(cuid())
  empireId  String
  kind      PotionKind
  count     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, kind])
}

/// A potion currently in effect. One row per (empire, kind); drinking another
/// of the same kind pushes `expiresAt` further out rather than being wasted.
/// Expiry is lazy — every reader filters on `expiresAt > now`, so no sweeper
/// job is needed and an offline player's buff runs out on its own.
model PotionEffect {
  id        String     @id @default(cuid())
  empireId  String
  kind      PotionKind
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, kind])
  @@index([empireId, expiresAt])
}

enum BuildingType {
  GOLD_MINE
  WOOD_CAMP
  IRON_MINE
  STONE_QUARRY
  BARRACKS
  SPY_CENTER
}

model Building {
  id             String       @id @default(cuid())
  empireId       String
  type           BuildingType
  level          Int          @default(1)
  slavesAssigned Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, type])
}

model Army {
  id         String   @id @default(cuid())
  empireId   String   @unique
  soldiers   Int      @default(0)
  spies      Int      @default(0)
  mineSlaves Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)
}

enum ResourceStorageType {
  GOLD
  WOOD
  IRON
  STONE
}

model ResourceStorage {
  id           String              @id @default(cuid())
  empireId     String
  resourceType ResourceStorageType
  level        Int                 @default(1)
  storedAmount Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, resourceType])
}

enum EmpireUpgradeType {
  CITIZEN_GROWTH
  DIAMOND_YIELD
  INTELLIGENCE
  BANK_DEPOSIT_COUNT
  BANK_DAILY_INTEREST
  TURNS_PER_REGULAR_UPDATE
  WHEEL_LUCK
}

model EmpireUpgrade {
  id        String            @id @default(cuid())
  empireId  String
  type      EmpireUpgradeType
  level     Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, type])
}

enum WeaponCategory {
  ATTACK
  DEFENSE
  SPY
}

model EmpireWeapon {
  id        String   @id @default(cuid())
  empireId  String
  weaponKey String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, weaponKey])
}

model EmpireWeaponUnlock {
  id           String         @id @default(cuid())
  empireId     String
  category     WeaponCategory
  unlockedTier Int            @default(2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  @@unique([empireId, category])
}

model BankAccount {
  id                          String   @id @default(cuid())
  empireId                    String   @unique
  goldBalance                 Float    @default(0)
  depositsUsedInCurrentPeriod Int      @default(0)
  depositPeriodStartedAt      DateTime @default(now())
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  empire       Empire            @relation(fields: [empireId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAW
  INTEREST
}

model BankTransaction {
  id            String              @id @default(cuid())
  bankAccountId String
  empireId      String
  type          BankTransactionType
  amount        Float
  balanceAfter  Float
  createdAt     DateTime            @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([empireId, createdAt])
}

model SpyReport {
  id                 String   @id @default(cuid())
  attackerEmpireId   String
  defenderEmpireId   String
  success            Boolean
  revealedGold       Float?
  revealedWood       Float?
  revealedIron       Float?
  revealedStone      Float?
  revealedSoldiers   Int?
  revealedSpies      Int?
  revealedMineSlaves Int?
  finalChance        Float?
  weaponsBonus       Float?
  /// Percentage points the attacker's guild spy buff added to the chance.
  /// Historical only — the spy spell was deleted on 2026-08-03 and reports
  /// written since leave this null. Kept so old reports still itemise the
  /// bonus they were actually decided by.
  guildBonus         Float?
  /// Attacker's effective intelligence power at resolution (deterministic spy).
  attackerIntel      Float?
  /// Defender's effective intelligence power at resolution (deterministic spy).
  defenderIntel      Float?
  /// The FULL intelligence dossier, frozen at the moment the spy got out:
  /// vaults, bank, arsenal, buildings, upgrades, hero, and every timed spell
  /// with its expiry. Shape and versioning: src/lib/game/spyIntel.ts.
  ///
  /// A snapshot rather than a live read on purpose — a report is what the spy
  /// saw, so re-opening it a day later must not silently show today's numbers.
  /// Null on a failed mission, and on every report written before this column
  /// existed (the result page falls back to the `revealed*` columns).
  revealed           Json?
  turnsSpent         Int      @default(5)
  createdAt          DateTime @default(now())

  attackerEmpire Empire @relation("SpyAttacker", fields: [attackerEmpireId], references: [id], onDelete: Cascade)
  defenderEmpire Empire @relation("SpyDefender", fields: [defenderEmpireId], references: [id], onDelete: Cascade)

  // Reports/base pages query "my spies sent" and "spies against me" newest-first;
  // the empire profile looks up the latest spy on a target. Unindexed these scan
  // the whole (ever-growing) report table.
  @@index([attackerEmpireId, createdAt])
  @@index([defenderEmpireId, createdAt])
}

enum SabotageKind {
  BURN_STORES
  STEAL_PLANS
  SPIKE_WELLS
}

/// חבלה — a spy mission that breaks something instead of looking at it.
///
/// Kept apart from SpyReport rather than folded into it with a `kind` column.
/// The two are read by different screens and carry different facts: a spy report
/// is a *dossier*, frozen and re-readable, while this is a *receipt* for damage
/// done. Sharing a table would have meant every column of each being nullable
/// for the other, on a model the reports page already reads on every visit.
///
/// The rule this table exists to keep honest, stated at length in
/// src/lib/game/sabotage.ts: sabotage never touches soldiers, weapons or power.
/// It takes stores, gold and mine slaves — the economy, which regrows, and which
/// the defender can see was taken.
model SabotageReport {
  id               String       @id @default(cuid())
  attackerEmpireId String
  defenderEmpireId String
  kind             SabotageKind
  success          Boolean

  /// Both sides' intelligence power at resolution. A sabotage mission needs a
  /// clear margin rather than a bare win (SABOTAGE_INTEL_MARGIN), and storing
  /// both figures is what lets the report say why it failed.
  attackerIntel Float
  defenderIntel Float

  turnsSpent Int
  /// Spies committed — lost outright on a failed mission.
  spiesSpent Int
  /// Spies actually lost. Zero on success; `spiesSpent` on failure, less
  /// whatever the attacker turned out not to have.
  spiesLost  Int @default(0)

  /// What the mission took, by kind. Only the columns its own mission uses are
  /// ever non-zero, which is why they are plain defaulted numbers rather than
  /// a JSON blob: the reports list sums them without parsing anything.
  goldTaken    Float @default(0)
  woodBurned   Float @default(0)
  ironBurned   Float @default(0)
  stoneBurned  Float @default(0)
  slavesKilled Int   @default(0)

  createdAt DateTime @default(now())

  attacker Empire @relation("SabotageAttacker", fields: [attackerEmpireId], references: [id], onDelete: Cascade)
  defender Empire @relation("SabotageDefender", fields: [defenderEmpireId], references: [id], onDelete: Cascade)

  /// The two reads this table gets: "my missions" and "what was done to me".
  @@index([attackerEmpireId, createdAt])
  @@index([defenderEmpireId, createdAt])
}

model BattleReport {
  id                    String   @id @default(cuid())
  attackerEmpireId      String
  defenderEmpireId      String
  attackerPower         Float
  defenderPower         Float
  attackerSoldiersPower Float?
  attackerWeaponsPower  Float?
  defenderSoldiersPower Float?
  defenderWeaponsPower  Float?
  winnerEmpireId        String
  attackerSoldiersLost  Int
  defenderSoldiersLost  Int
  // Defender soldiers captured by a winning attacker — they join the
  // attacker's free mine-slave pool.
  enslavedSoldiers      Int      @default(0)
  stolenGold            Float
  stolenWood            Float
  stolenIron            Float
  stolenStone           Float
  turnsSpent            Int      @default(10)
  createdAt             DateTime @default(now())

  // Hero: battle XP awarded to each side and the % power bonus each hero added.
  attackerHeroBonusPct Float?
  defenderHeroBonusPct Float?

  // Guild spells: % power bonus each side's active buff added (attack buff
  // for the attacker, defense buff for the defender).
  attackerGuildBonusPct Float?
  defenderGuildBonusPct Float?

  // Passive guild aid: a flat power reinforcement equal to `…AidPct` percent of
  // the guild's combined military power, added after every own-troop
  // multiplier. Snapshotted because the guild's roster and its aid level both
  // move — the report has to say what this battle was actually fought with.
  attackerGuildAidPct   Float?
  attackerGuildAidPower Float?
  defenderGuildAidPct   Float?
  defenderGuildAidPower Float?

  // The defender's flat multiplier (20 = +20%), snapshotted because it is a
  // live tunable. Without it the defence column simply does not add up: it is
  // the largest single term after the troops themselves, and the report never
  // mentioned it.
  defenseBonusPct Float?
  attackerHeroXp  Int    @default(0)
  defenderHeroXp  Int    @default(0)

  // Hero item captured by the attacker on a win (denormalized snapshot).
  droppedItemSlot   HeroItemSlot?
  droppedItemLevel  Int?
  droppedItemRarity HeroRarity?

  // A winning attack can also award a wheel-of-fortune spin (wheel-luck upgrade).
  wonWheelSpin Boolean @default(false)

  // Potion looted by the attacker on a win (denormalized snapshot, like the item).
  droppedPotionKind PotionKind?

  // Diamond raid shields the defender held when the blow landed — they are why
  // a won battle can still end with an empty haul.
  defenderResourceShielded Boolean @default(false)
  defenderSoldierShielded  Boolean @default(false)

  /// להט הקרב at the moment this raid resolved, as a percent on top of the haul
  /// (50 = ×1.5). Null when the meter was cold, when the day's allowance of
  /// boosted attacks was already spent, or when the raid paid nothing anyway —
  /// i.e. null means "the meter did not change this report".
  ///
  /// Snapshotted rather than recomputed for the same reason every `…BonusPct`
  /// above is: the report is a record of a battle that happened, and the meter
  /// it was fought under has decayed by the time anybody reads it.
  ///
  /// Deliberately NOT part of `battlePowerLedger` — that ledger itemises the
  /// terms of the *power* comparison, and this modifies the haul, not who won.
  attackerFervorPct Float?

  attackerEmpire Empire @relation("BattleAttacker", fields: [attackerEmpireId], references: [id], onDelete: Cascade)
  defenderEmpire Empire @relation("BattleDefender", fields: [defenderEmpireId], references: [id], onDelete: Cascade)

  // Reports/base pages query battles by attacker and by defender newest-first;
  // the leaderboards "biggest theft" board groups by createdAt window. All three
  // are hot paths that would otherwise scan the whole battle-report table.
  @@index([attackerEmpireId, createdAt])
  @@index([defenderEmpireId, createdAt])
  @@index([createdAt])
}

/// One of the three things the boss does in a round. Rolled into the assault plan
/// at launch and shown in the log as the army meets it, so the reveal is a replay
/// of something already decided rather than a live draw.
enum BossMove {
  /// A heavy overhead blow. Answered by a shield wall.
  SMASH
  /// A sweep across the massed lines. Answered by spreading and flanking.
  SWEEP
  /// The tyrant overextends and bares its guard. The window for a frontal charge.
  EXPOSED
}

/// The answer the army's officers chose. Picked by `autoTactic` — the counter on a
/// successful read, one of the two wrong answers otherwise. FURY is the hero's
/// charged strike, released the moment the meter fills.
enum BossTactic {
  ASSAULT
  SHIELD
  FLANK
  FURY
}

/// How a sortie ended. Only KILLED writes `BossFight.victory = true`.
enum BossBattleStatus {
  /// The assault is under way — its clock has not run out yet.
  ACTIVE
  /// The tyrant fell to this assault.
  KILLED
  /// The army broke (losses past the rout line) and pulled back early.
  ROUTED
  /// The rounds ran out with the boss still standing.
  SPENT
  /// Unused since the fight stopped taking player input; kept so reports written
  /// while retreating was a button still render.
  RETREATED
  /// The boss died or revived out from under the assault before it settled.
  EXPIRED
}

/// A siege of one city boss, for one empire, for one daily-update cycle.
///
/// This is the row that made the boss worth coming back to. It used to be one
/// all-or-nothing swing capped at a single victory per cycle: a player below the
/// boss's power got nothing but a mauled army, and a player above it got one
/// win and then had nothing to do with the boss until the next update. Now the
/// boss carries a health pool that *persists between sorties* — every attack
/// that lands leaves it wounded, damage pays loot pro-rata as it is dealt, and
/// felling it pays the hoard on top.
///
/// The cycle boundary is the identity, not a timestamp to compare: `cycleAt` is
/// `lastDailyUpdate()` at creation, so a new cycle simply misses the unique key
/// and a fresh, full-health siege is created. Nothing needs to sweep old rows.
///
/// The loot pool is also what replaced the victory cap. Total chip loot is
/// bounded by `maxHp` (you cannot deal more damage than the boss has health) and
/// the kill bonus is paid once per siege, so a player who banked turns for a
/// fortnight can spend them on extra sorties without minting extra loot — the
/// turns buy attempts, not payouts. See src/lib/game/bossBattle.ts.
model BossSiege {
  id       String @id @default(cuid())
  empireId String

  /// City tier under siege and its boss — snapshots, as on BossFight.
  cityTier Int
  bossKey  String

  /// Health pool for this life, and what is left of it.
  maxHp       Float
  hp          Float
  /// Running total of damage this life has taken (`maxHp - hp`, kept explicitly
  /// so a report can show progress without recomputing from the battle logs).
  damageDealt Float @default(0)
  /// Assaults launched against this life.
  sorties     Int   @default(0)

  /// When the tyrant fell, and when it returns. Both null while it lives; both
  /// set together on the killing blow. A row with `revivesAt` in the past is a
  /// spent life — the next assault opens a fresh one rather than reusing it.
  killedAt  DateTime?
  revivesAt DateTime?

  createdAt DateTime @default(now())

  empire  Empire       @relation(fields: [empireId], references: [id], onDelete: Cascade)
  battles BossBattle[]

  /// The one lookup: this empire's newest life of a given tier's boss. There is
  /// no unique key to collide on any more — lives accumulate — so concurrent
  /// marches are serialised by the empire row lock in `startBossAssault`.
  @@index([empireId, cityTier, createdAt])
}

/// One assault on a besieged boss: a battle the army fights on its own, rolled in
/// full at launch and revealed over `BOSS_ASSAULT_DURATION_MS` of real time.
///
/// The row is a **plan plus a deadline**, not a live game state. Every round —
/// the boss's move, the tactic the officers chose, the damage, the casualties — is
/// decided and stored the moment the player presses attack; `endsAt` is when it
/// finishes; and the totals are applied to the world in a single write at the
/// settle (see `settleDueAssault`).
///
/// That shape is what lets the player walk away. There is no per-round request to
/// miss, nothing to resume, and no way for the outcome to depend on whether anyone
/// was watching: an assault interrupted by a closed laptop pays exactly what it
/// would have paid. The un-elapsed rounds are filtered out server-side, so the
/// client is never handed the ending early.
///
/// `attackPower` and `soldiersAtStart` are snapshotted at launch: the army that
/// marched is the army that fought, so reinforcements trained during the minute
/// cannot retroactively join a battle that is already decided.
model BossBattle {
  id       String @id @default(cuid())
  siegeId  String
  empireId String

  status BossBattleStatus @default(ACTIVE)

  /// Rounds the plan actually contains (a kill or a rout ends it early), and the
  /// limit it was rolled against.
  round     Int
  maxRounds Int

  /// How the rolled battle ends. Stored rather than re-derived at the settle: the
  /// distinction between "ran out of rounds" and "broke and pulled back early" is
  /// the simulation's to make, and inferring it from the log is the kind of guess
  /// that quietly pays the wrong loot.
  outcome BossBattleStatus

  /// Battle power that marched, and the bonuses it was built from (mirrored onto
  /// the BossFight report exactly as a player battle mirrors them).
  attackPower   Float
  heroBonusPct  Float?
  guildBonusPct Float?

  soldiersAtStart Int
  /// Totals from the plan. Decided at launch; applied at the settle.
  soldiersLost    Int
  damageDealt     Float
  /// The boss's remaining health when this assault began, for the report's bar.
  hpAtStart       Float

  /// Rounds the officers read correctly, out of rounds fought. The grade is built
  /// from these two — see `bossReadChance`, which is what the hero contributes.
  correctCounters Int
  decisions       Int

  turnsSpent Int

  /// The plan: `{ round, move, tactic, correct, furyUsed, damage, soldiersLost,
  /// bossHpAfter, fury, at }` per round, where `at` is the reveal offset in ms.
  log Json @default("[]")

  startedAt DateTime  @default(now())
  /// When the assault completes and becomes payable. The settle is lazy — any read
  /// past this instant performs it, including the inbox poll, so the player is
  /// notified within one poll interval wherever they happen to be.
  endsAt    DateTime
  endedAt   DateTime?

  siege  BossSiege  @relation(fields: [siegeId], references: [id], onDelete: Cascade)
  empire Empire     @relation(fields: [empireId], references: [id], onDelete: Cascade)
  fight  BossFight?

  /// The hot lookups: this empire's running assault, and the sweep for assaults
  /// whose clock has run out.
  @@index([empireId, status])
  @@index([status, endsAt])
  @@index([siegeId])
}

/// One settled sortie at the city boss — the PvE tyrant guarding each city tier.
/// See src/lib/game/bosses.ts for the catalog, src/lib/game/bossBattle.ts for
/// the round-by-round combat, and src/server/bossSiege.ts for resolution.
///
/// Written when a sortie *ends*, whatever ended it. `victory` is true only for a
/// kill, which is what keeps the honour roll, the achievement counters and the
/// admin monitor reading the same thing they always did.
model BossFight {
  id       String @id @default(cuid())
  empireId String

  /// City tier fought (1..MAX_CITIES) and the boss that rules it. Both are
  /// denormalized snapshots: the empire may found another city afterwards, and
  /// the report must keep showing the fight that actually happened.
  cityTier Int
  bossKey  String

  victory       Boolean
  attackerPower Float
  bossPower     Float
  soldiersLost  Int
  turnsSpent    Int

  /// Spoils. All zero on a defeat — the boss keeps its hoard.
  rewardGold   Float @default(0)
  rewardWood   Float @default(0)
  rewardIron   Float @default(0)
  rewardStone  Float @default(0)
  rewardSlaves Int   @default(0)

  /// Battle bonuses that were in effect, mirrored from BattleReport so the
  /// report page can show the same power breakdown a player battle shows.
  heroBonusPct  Float?
  guildBonusPct Float?
  heroXp        Int    @default(0)

  /// Gear the felled boss dropped (denormalized snapshot, as on BattleReport).
  droppedItemSlot   HeroItemSlot?
  droppedItemLevel  Int?
  droppedItemRarity HeroRarity?

  /// The sortie that produced this report, and how it ended. `battleId` is null
  /// only on reports written before the siege rework.
  battleId String?           @unique
  endedBy  BossBattleStatus?

  /// Siege progress the sortie made: damage dealt, and the pool it came out of.
  /// The chip loot above is `damageDealt / bossMaxHp` of the cycle's haul.
  damageDealt Float   @default(0)
  bossMaxHp   Float   @default(0)
  bossHpAfter Float   @default(0)
  /// Rounds fought, and the grade the play earned ("S" | "A" | "B" | "C").
  /// Only a kill is graded — the grade multiplies the kill bonus.
  rounds      Int     @default(0)
  grade       String?

  createdAt DateTime @default(now())

  empire Empire      @relation(fields: [empireId], references: [id], onDelete: Cascade)
  battle BossBattle? @relation(fields: [battleId], references: [id], onDelete: SetNull)

  // The per-cycle victory allowance counts this empire's recent wins on every
  // run; the rankings banner lists the conquerors of one city tier newest-first.
  @@index([empireId, createdAt])
  @@index([cityTier, victory, createdAt])
}

/// One fixed-window rate-limit counter, shared by every instance of the app.
///
/// The limiter used to live in module memory, which on a serverless fleet is
/// not a limiter at all: every cold start hands the caller a fresh set of
/// counters and every concurrent instance keeps its own, so the effective
/// budget is `limit × instances` and resets whenever the platform feels like
/// it. Login brute-force, mass registration and mass-mail all rode straight
/// through it. Postgres is the one piece of shared state the app already has,
/// so the counters live here.
///
/// Rows are self-expiring by comparison (`resetAt <= now` starts a new window
/// in place); `sweepRateLimits` drops the dead ones opportunistically.
model RateLimitBucket {
  /// The caller-supplied bucket key, e.g. `login-email:someone@example.com`.
  key     String   @id
  count   Int      @default(0)
  /// When the current window rolls over and `count` starts again at 1.
  resetAt DateTime

  /// Drives the opportunistic sweep of expired windows.
  @@index([resetAt])
}

enum ChatChannel {
  /// The town square: one room every player reads and writes.
  GLOBAL
  /// A two-person conversation, addressed by `recipientEmpireId`.
  DIRECT
}

/// One line of live chat — a global room message or half of a private
/// conversation.
///
/// Deliberately NOT a `Message`. The inbox is a mailbox: rows are titled,
/// linkable, individually read-marked and kept forever, because a battle alert
/// is a record. Chat is a stream — no title, no href, read in bulk, and only the
/// tail is ever shown — so a shared table would have meant a nullable title, a
/// kind that behaves unlike every other kind, and every inbox query growing a
/// `kind NOT IN (…)` filter. See src/lib/game/chat.ts.
///
/// `senderName` is denormalised on purpose. A chat pane renders a hundred lines
/// at a time and each one needs an author, so the alternative is a join (or an
/// N+1) on the hottest polled query in the game; and when an empire is deleted
/// the FK goes null while the conversation stays readable — the name it was said
/// under is part of the line, not a lookup.
model ChatMessage {
  id      String      @id @default(cuid())
  channel ChatChannel @default(GLOBAL)

  /// Author. SetNull (not Cascade) so a deleted player does not tear holes in
  /// everyone else's transcript.
  senderEmpireId    String?
  /// The author's empire name as it stood when the line was written.
  senderName        String
  /// The other side of a DIRECT line. Always null for GLOBAL.
  recipientEmpireId String?

  body String

  /// Set when an admin removes the line. Hidden rows are filtered out of every
  /// read path rather than deleted, so moderation is auditable and reversible.
  hiddenAt   DateTime?
  hiddenById String?

  /// When the recipient of a DIRECT line saw it — drives the unread badge.
  /// Always null for GLOBAL, where "unread" is a client-side high-water mark.
  readAt DateTime?

  createdAt DateTime @default(now())

  sender    Empire? @relation("ChatSender", fields: [senderEmpireId], references: [id], onDelete: SetNull)
  recipient Empire? @relation("ChatRecipient", fields: [recipientEmpireId], references: [id], onDelete: Cascade)

  /// The global room's tail: `WHERE channel = 'GLOBAL' ORDER BY createdAt DESC`.
  @@index([channel, createdAt])
  /// The unread badge, and the inbound half of a thread.
  @@index([recipientEmpireId, createdAt])
  /// The outbound half of a thread, and the "did I just say this?" repeat check.
  @@index([senderEmpireId, createdAt])
}

/// "X is typing…", as one self-expiring row per player.
///
/// A typing marker is the most write-heavy, least valuable thing in the chat: it
/// is true for two seconds and nobody may ever see it. So it is deliberately not
/// a message row and not a column on Empire — one row per *player* (the empire
/// is the primary key), overwritten in place, read by comparing `updatedAt`
/// against a TTL. Nothing sweeps it: a stale row is already inert, and the next
/// keystroke overwrites it.
model ChatTyping {
  /// Who is typing. Primary key, so a player has exactly one marker no matter
  /// how many conversations they switch between.
  empireId   String   @id
  /// Denormalised for the same reason as on ChatMessage: the indicator names
  /// the typist, and a join for a value this ephemeral is not worth it.
  name       String
  /// Null = the public room; otherwise the conversation being typed into. Only
  /// that partner is ever shown the marker.
  toEmpireId String?
  updatedAt  DateTime

  empire Empire @relation(fields: [empireId], references: [id], onDelete: Cascade)

  /// The read: everyone typing into this room/conversation, recently enough.
  @@index([toEmpireId, updatedAt])
}

/// A captured application error.
///
/// The app had nowhere to record one. Uncaught server errors went to the
/// platform log and scrolled away, and — worse — the ~44 server actions that end
/// in `catch { return { error: "אירעה שגיאה, נסה שוב" } }` swallowed the real
/// exception entirely: the player saw a generic Hebrew sentence and the cause
/// was gone. Every one of those is now recorded here first.
///
/// Deliberately not a general-purpose log: only errors, capped in size, and
/// swept by age. It exists so /admin/monitor can answer "did anything break?"
model ErrorLog {
  id String @id @default(cuid())

  /// Where it came from — a server action name, a route, or "render".
  source   String
  message  String
  /// Truncated; a stack is for recognising the bug, not for reading in full.
  stack    String?
  /// Request path, when one was in scope.
  path     String?
  /// Whose session hit it, when known. No FK: an error must survive the user.
  userId   String?
  empireId String?
  /// How many times this same (source, message) pair has been seen since
  /// `createdAt` — one bad deploy must not write ten thousand rows.
  count    Int     @default(1)

  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  /// The monitor reads newest-first; the sweep deletes by age.
  @@index([lastSeen])
  /// Dedupe lookups.
  @@index([source, message])
}

enum SupportStatus {
  /// Waiting on somebody — either the visitor or the staff.
  OPEN
  /// Settled. Still readable by both sides; reopens the moment the visitor
  /// writes again, because a "closed" ticket is our opinion, not theirs.
  CLOSED
}

/// One conversation with somebody who is *not* in the game yet — the support
/// chat that sits on the login and registration screens.
///
/// It exists because the players who most need to reach a human are exactly the
/// ones the rest of the app cannot see: an unverified address, a forgotten
/// password, a Google account that will not link, a ban to argue, a payment made
/// from an account that cannot log in. All of those happen *in front of* the
/// session, so none of them can use the in-game chat (see ChatMessage), which
/// is addressed by empire id and refuses everyone without one.
///
/// **Nothing here has a foreign key, on purpose.** A ticket has to outlive the
/// account it is about: the visitor may have no account at all, may delete the
/// one they have, and a season reset wipes every empire in the game. A support
/// record that vanished with the empire would take the evidence of a payment
/// dispute with it.
model SupportThread {
  id String @id @default(cuid())

  /// SHA-256 of the token in the visitor's cookie — never the token itself, so
  /// a dump of this table does not hand anybody else's conversation to the
  /// reader. The raw value exists only in the visitor's browser and in the
  /// request that presents it. Same shape as EmailVerificationToken.
  tokenHash String @unique

  /// Where to reach them if they close the tab. Optional, and asked for rather
  /// than required: a visitor who is already frustrated must be able to say
  /// what is wrong in one action.
  email String?

  /// The account behind the visit, when there is one. No FK — see the note
  /// above. Written on every message, because a visitor who signs in mid-chat
  /// (or whose session is what is broken) is worth knowing about.
  userId     String?
  /// Their empire's name at the time of writing, when they have one. Purely so
  /// staff can recognise a player without a lookup.
  empireName String?

  /// The screen they were on when the conversation started, and the browser
  /// they were using. Both are context for "it does not work" — which is what
  /// most first messages say.
  path      String?
  userAgent String?
  /// For rate-limit forensics and to spot one person opening ten tickets.
  ip        String?

  status SupportStatus @default(OPEN)

  /// Last line either side wrote — the inbox sorts on it.
  lastMessageAt DateTime  @default(now())
  /// When staff last read the thread, and when the visitor last did. Each side's
  /// unread badge is "messages from the other side, newer than this".
  staffReadAt   DateTime?
  visitorReadAt DateTime?
  /// When Discord was last pinged about this thread — the cooldown that keeps a
  /// visitor typing six short lines from posting six notifications.
  notifiedAt    DateTime?

  createdAt DateTime @default(now())

  messages SupportMessage[]

  /// The admin inbox: open threads, newest activity first.
  @@index([status, lastMessageAt])
  /// The same read without the status filter, for the "all" tab.
  @@index([lastMessageAt])
}

model SupportMessage {
  id       String @id @default(cuid())
  threadId String

  /// Which side wrote it. A boolean rather than an author id because that is
  /// the only distinction either reader cares about: "us" or "them".
  fromStaff  Boolean @default(false)
  /// Which admin answered, for the audit trail. No FK, same reason as above.
  staffId    String?
  /// The name shown on the line — the admin's, or the visitor's if they gave
  /// one. Denormalised like ChatMessage.senderName, and for the same reason.
  authorName String

  body String

  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// The transcript, and the poll cursor over it.
  @@index([threadId, createdAt])
}
